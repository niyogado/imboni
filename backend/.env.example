# iMBONi Backend Environment Variables
# Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
PORT=4000
BASE_URL=http://localhost:4000

# Database
DATABASE_URL="mysql://root:root@localhost:3306/imboni_dev"

# JWT
JWT_SECRET=replace-with-a-strong-secret-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt
BCRYPT_SALT_ROUNDS=12

# CORS
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug